# ─────────────────────────────────────────────────────────────────────────
# Park Patrol — backend configuration (copy to .env). Nothing here reaches the
# browser bundle.
# ─────────────────────────────────────────────────────────────────────────

# Backend port: REST + Socket.IO on ONE port (Astrikos pair 3357 web / 4357 API).
PORT=4357

# Shared password for the seeded demo accounts. Change before any non-demo use.
APP_PASSWORD=Astrikos2026

# Lock the API to the web app's origin(s) in production (comma-separated).
# Unset = reflect any origin (fine for a demo / LAN testing).
# ALLOWED_ORIGINS=https://parking.astrikos.xyz:8443

# ─────────────────────────────────────────────────────────────────────────
# AI — OPTIONAL. Everything AI-related works rules-based with no model:
# forecasts, hotspots, repeat offenders, anomalies, deployment advice, the
# advisory brief and the phone's offline plate reader. A model adds:
#   • a second, server-side read of every uploaded plate photo ("AI check")
#   • the advisory brief worded in plain English from the engine's numbers
# One of: groq | gemini | openrouter | ollama | anthropic | none
# ─────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=none
LLM_API_KEY=
# LLM_MODEL=
# LLM_VISION_MODEL=
